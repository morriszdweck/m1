diff --git a/src/llama-model-loader.cpp b/src/llama-model-loader.cpp
index 548ade101..3a05d0f70 100644
--- a/src/llama-model-loader.cpp
+++ b/src/llama-model-loader.cpp
@@ -801,6 +801,59 @@ llama_model_loader::llama_model_loader(
         llm_kv = LLM_KV(llm_arch_from_string(arch_name));
     }
 
+    // SenseNova Loop: run the shared block LLAMA_SENSENOVA_LOOPS times instead of the count in the file.
+    // The file keeps the shared layers once and the layers after the loop under their logical numbers,
+    // so only the layer count, the per-layer attention list and those later layers' names change.
+    if (const char * want = getenv("LLAMA_SENSENOVA_LOOPS"); want && arch_name == "sensenova_loop" && !files.empty()) {
+        const int loops = atoi(want);
+        auto u32 = [&](const char * key) -> int64_t {
+            const int64_t id = gguf_find_key(metadata, key);
+            return id < 0 ? -1 : (int64_t) gguf_get_val_u32(metadata, id);
+        };
+        const int64_t start = u32("sensenova_loop.loop.start"), end = u32("sensenova_loop.loop.end");
+        const int64_t count = u32("sensenova_loop.loop.count"), blocks = u32("sensenova_loop.block_count");
+        const int64_t recr_id = gguf_find_key(metadata, "sensenova_loop.attention.recurrent_layers");
+        if (loops < 1 || loops > 8 || start < 0 || end <= start || count < 1 || blocks < 0 || recr_id < 0 ||
+                gguf_get_arr_type(metadata, recr_id) != GGUF_TYPE_BOOL || (int64_t) gguf_get_arr_n(metadata, recr_id) != blocks) {
+            throw std::runtime_error(format("LLAMA_SENSENOVA_LOOPS=%s can't be applied to this model", want));
+        }
+        if (loops != count) {
+            const int64_t width = end - start;
+            const int64_t old_extra = (count - 1) * width, new_extra = (int64_t) (loops - 1) * width;
+            const int64_t new_blocks = blocks - old_extra + new_extra;
+            if (new_blocks > LLAMA_MAX_LAYERS) {
+                throw std::runtime_error(format("LLAMA_SENSENOVA_LOOPS=%d needs too many layers", loops));
+            }
+            // the file's logical layer for each logical layer of the new plan
+            auto old_index = [&](int64_t il) -> int64_t {
+                if (il < start) return il;
+                if (il < end + new_extra) return start + (il - start) % width;
+                return il - new_extra + old_extra;
+            };
+            const int8_t * recr_old = (const int8_t *) gguf_get_arr_data(metadata, recr_id);
+            std::vector<int8_t> recr_new(new_blocks);
+            for (int64_t il = 0; il < new_blocks; ++il) recr_new[il] = recr_old[old_index(il)];
+            gguf_set_arr_data(metadata, "sensenova_loop.attention.recurrent_layers", GGUF_TYPE_BOOL, recr_new.data(), recr_new.size());
+            gguf_set_val_u32(metadata, "sensenova_loop.block_count", (uint32_t) new_blocks);
+            gguf_set_val_u32(metadata, "sensenova_loop.loop.count", (uint32_t) loops);
+
+            std::map<int64_t, int64_t> rename; // old layer number -> new layer number
+            for (int64_t il = end + new_extra; il < new_blocks; ++il) rename[old_index(il)] = il;
+            decltype(weights_map) renamed;
+            for (auto & it : weights_map) {
+                std::string name = it.first;
+                int layer = -1, used = 0;
+                if (sscanf(name.c_str(), "blk.%d.%n", &layer, &used) == 1 && used > 0 && rename.count(layer)) {
+                    name = format("blk.%d.", (int) rename[layer]) + name.substr(used);
+                    ggml_set_name(it.second.tensor, name.c_str());
+                }
+                renamed.emplace(name, it.second);
+            }
+            weights_map = std::move(renamed);
+        }
+        LLAMA_LOG_INFO("%s: SenseNova Loop runs its shared block %d times (file: %d)\n", __func__, loops, (int) count);
+    }
+
     n_kv      = gguf_get_n_kv(metadata);
     n_tensors = weights_map.size();
 
